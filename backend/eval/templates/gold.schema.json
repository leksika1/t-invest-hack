        "pages_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pages File"
        },
        "pages_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pages Sha256"
        }
      },
      "required": [
        "document_id",
        "filename",
        "path",
        "sha256"
      ],
      "title": "GoldDocument",
      "type": "object"
    },
