{
  "$defs": {
    "Atom": {
      "additionalProperties": false,
      "description": "One expected array element, with pre-approved paraphrases/slot constraints.",
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "category": {
          "default": "other",
          "enum": [
            "covenants",
            "call",
            "early_redemption",
            "put",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "constraints": {
          "additionalProperties": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Constraints",
          "type": "object"
        }
      },
      "required": [
        "index",
        "condition_id"
      ],
      "title": "Atom",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause"
        },
        "value_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Path"
        }
      },
      "required": [
        "quote",
        "document_id",
        "page"
      ],
      "title": "Citation",
      "type": "object"
    },
    "GoldDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "default": "decision",
          "title": "Type",
          "type": "string"
        },
        "origins": {
