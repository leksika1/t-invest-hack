# Порт, на котором приложение доступно снаружи
APP_PORT=80

# Postgres (порт БД наружу не публикуется)
POSTGRES_DB=bonds
POSTGRES_USER=bonds
POSTGRES_PASSWORD=change-me

# LLM: любой OpenAI-совместимый API. Пустой ключ — LLM не используется (health: llm=not_configured)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
